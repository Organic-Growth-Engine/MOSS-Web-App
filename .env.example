# Copy to .env.local and adjust. All NEXT_PUBLIC_* values are inlined at build time.

# API gateway base URL (every service is reached through it).
NEXT_PUBLIC_API_BASE_URL=/api/v1
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# Per-service mock toggles. Unset = true (mock). Set a service to false once its backend is live.
# identity should go live first (or together with the others): real services reject mock tokens.
NEXT_PUBLIC_USE_MOCK_IDENTITY=true
NEXT_PUBLIC_USE_MOCK_WORKSPACE=true
NEXT_PUBLIC_USE_MOCK_ACCOUNTS=true
NEXT_PUBLIC_USE_MOCK_CONTENT=true
NEXT_PUBLIC_USE_MOCK_MEDIA=true
NEXT_PUBLIC_USE_MOCK_ANALYTICS=true
NEXT_PUBLIC_USE_MOCK_NOTIFICATIONS=true
NEXT_PUBLIC_USE_MOCK_SEARCH=true

# Optional: call one service directly instead of through the gateway.
# NEXT_PUBLIC_CONTENT_API_URL=http://localhost:4003/api/v1

# Mock-only: simulated latency (ms), and a fixed "now" for relative dates.
# While content is mocked, "now" defaults to 2026-03-23T12:00:00-07:00 (the fixtures' day).
NEXT_PUBLIC_MOCK_LATENCY_MS=120
# NEXT_PUBLIC_DEMO_NOW=2026-03-23T12:00:00-07:00
